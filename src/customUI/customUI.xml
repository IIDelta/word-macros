<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabMWTools" label="MW Tools" insertAfterMso="TabHome">
        
        <group id="grpComparison" label="Comparison &amp; Redlines">
          <button id="btnYellowRedline" label="Yellow Highlight Redline" size="large" imageMso="ReviewTrackChanges" onAction="OnAction_YellowRedline" />
          <button id="btnStandardRedline" label="Standard Redline" size="normal" imageMso="ReviewCompareTwoVersions" onAction="OnAction_StandardRedline" />
        </group>

        <group id="grpCleanup" label="Document Cleanup">
          <button id="btnRemoveSpaces" label="Remove Multiple Spaces" size="normal" imageMso="FindAndReplace" onAction="OnAction_RemoveSpaces" />
          <button id="btnDeleteHidden" label="Delete Hidden Text" size="normal" imageMso="FormattingMarkShowHide" onAction="OnAction_DeleteHidden" />
          <button id="btnUpdateFields" label="Update All Fields" size="normal" imageMso="FieldUpdate" onAction="OnAction_UpdateFields" />
        </group>

        <group id="grpReview" label="Review Tools">
          <button id="btnReopenComments" label="Reopen All Comments" size="large" imageMso="ReviewShowAllComments" onAction="OnAction_ReopenComments" />
        </group>
        
      </tab>
    </tabs>
  </ribbon>
</customUI>